{
  "llm": {
    "provider": "openai_compatible",
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-chat",
    "temperature": 0.3,
    "max_tokens": 1024,
    "timeout": 60,
    "_note": "已配好 DeepSeek。key 写入同目录 api_key.txt 一行即可（已 gitignore），或用环境变量 OPENAI_API_KEY。provider: openai_compatible=OpenAI兼容接口 | mock=不联网测试"
  },
  "detector": {
    "weights": "../YOLOvx/runs/detect/class_50ep/weights/best.pt",
    "conf": 0.25,
    "iou": 0.45,
    "imgsz": 640,
    "device": "",
    "_note": "_weights填训练好的YOLO权重路径(相对agent目录);conf置信度阈值;device留空自动(有GPU用GPU)"
  },
  "analysis": {
    "focus": ["using_phone", "sleep", "stand", "raise_head"],
    "_note": "异常行为类别,对应模型7类:sleep/raise_head/using_computer/stand/using_phone/raise_hand/read",
    "language": "zh"
  }
}
